{
  "name": "nimbalyst-git-insights",
  "version": "0.1.0",
  "private": true,
  "description": "Git Insights extension for Nimbalyst — commit heatmap, commit distribution charts, one-click PR/MR, and AI session attribution for uncommitted files",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.backend.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nimbalyst/extension-sdk": "^0.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.0.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
